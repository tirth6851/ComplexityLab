# =========================
# Secrets / local env
# =========================
.env
.env.*
!.env.example
*.pem

# =========================
# Node / Next.js
# =========================
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# =========================
# Logs & caches
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.turbo/
coverage/

# =========================
# OS / editor
# =========================
.DS_Store
Thumbs.db
*.swp
.idea/

# Keep VS Code shared config, ignore per-user
.vscode/*
!.vscode/mcp.json
!.vscode/settings.json

# =========================
# Playwright MCP artifacts
# Generated during AI-assisted testing sessions; never committed
# =========================
.playwright-mcp/

# =========================
# Verification screenshots
# Generated by Playwright during dev/review
# =========================
*.png

# =========================
# Root-level package-lock
# The project lockfile lives in frontend/
# =========================
/package-lock.json
