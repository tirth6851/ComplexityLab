# =========================
# CLERK AUTH
# Get keys: https://dashboard.clerk.com -> API Keys
# =========================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=<your-clerk-secret-key>

# =========================
# SUPABASE
# Get keys: https://supabase.com/dashboard -> Project Settings -> API
# WARNING: SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose to the client.
# =========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =========================
# AI ANALYSIS PROVIDER
# "mock" (default) = deterministic heuristic engine, no network.
# "groq" = LLM analysis via Groq, with automatic fallback to the
# heuristic engine on any failure. openai/anthropic/gemini are scaffolded.
# =========================
AI_PROVIDER=groq

# =========================
# GROQ (LLM inference — used when AI_PROVIDER=groq)
# Get key: https://console.groq.com/keys
# =========================
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# =========================
# JUDGE0 CE (code execution — via RapidAPI)
# Get key: https://rapidapi.com/judge0-official/api/judge0-ce
# WARNING: server-only. Never use NEXT_PUBLIC_ prefix for these.
# =========================
JUDGE0_API_KEY=<your-rapidapi-key>
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# =========================
# APP
# =========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
