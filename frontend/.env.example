# =========================
# CLERK AUTH
# Get keys: https://dashboard.clerk.com -> API Keys
# =========================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=<your-clerk-secret-key>

# =========================
# SUPABASE
# Get keys: https://supabase.com/dashboard -> Project Settings -> API
# WARNING: SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose to the client.
# =========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =========================
# AI ANALYSIS PROVIDER
# "mock" (default) = deterministic heuristic engine, no network.
# "groq" = LLM analysis via Groq, with automatic fallback to the
# heuristic engine on any failure. openai/anthropic/gemini are scaffolded.
# =========================
AI_PROVIDER=groq

# =========================
# GROQ (LLM inference — used when AI_PROVIDER=groq)
# Get key: https://console.groq.com/keys
# =========================
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# =========================
# JUDGE0 CE (code execution — via RapidAPI)
# Get key: https://rapidapi.com/judge0-official/api/judge0-ce
# WARNING: server-only. Never use NEXT_PUBLIC_ prefix for these.
# =========================
JUDGE0_API_KEY=<your-rapidapi-key>
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# --- Cost protection (optional but strongly recommended in production) ---
# JUDGE0_ENABLED=false          # Emergency kill switch: set to "false" to pause all execution immediately
# JUDGE0_GLOBAL_DAILY_CAP=900   # Max submissions/day across ALL users (~$0.90 overage cap). Not enforced when unset.
# JUDGE0_USER_DAILY_QUOTA=100   # Max submissions/day per user (default 100)

# =========================
# CHAT (optional — used by POST /api/chat)
# CHAT_PROVIDER: "mock" (deterministic, no network) or "groq" (default when
# GROQ_API_KEY is set, no fallback — chat streams, so it can't retry mid-stream).
# CHAT_MODEL defaults to GROQ_MODEL when unset.
# =========================
# CHAT_PROVIDER=groq
# CHAT_MODEL=llama-3.3-70b-versatile

# =========================
# RATE LIMITING (optional — Upstash Redis REST API)
# Unset = in-memory sliding window, enforced per warm serverless instance only.
# Set both to enforce limits globally across all instances via Upstash's
# REST API (no SDK/driver needed). Get credentials: https://console.upstash.com
# WARNING: server-only. Never use NEXT_PUBLIC_ prefix for these.
# =========================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# =========================
# APP
# =========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
